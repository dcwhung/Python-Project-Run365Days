<?xml version="1.0" encoding="UTF-8"?>
<!-- Indoor / treadmill shape: no Position, no AltitudeMeters, no MaximumSpeed,
     no Calories. Every one of these is optional in the TCX v2 schema. -->
<TrainingCenterDatabase
  xmlns:ns3="http://www.garmin.com/xmlschemas/ActivityExtension/v2"
  xmlns="http://www.garmin.com/xmlschemas/TrainingCenterDatabase/v2">
  <Activities>
    <Activity Sport="Running">
      <Id>2021-02-11T22:30:00.000Z</Id>
      <Lap StartTime="2021-02-11T22:30:00.000Z">
        <TotalTimeSeconds>300.0</TotalTimeSeconds>
        <DistanceMeters>1000.0</DistanceMeters>
        <Track>
          <Trackpoint>
            <Time>2021-02-11T22:30:00.000Z</Time>
            <DistanceMeters>0.0</DistanceMeters>
          </Trackpoint>
          <Trackpoint>
            <Time>2021-02-11T22:35:00.000Z</Time>
            <DistanceMeters>1000.0</DistanceMeters>
          </Trackpoint>
        </Track>
      </Lap>
    </Activity>
  </Activities>
</TrainingCenterDatabase>
