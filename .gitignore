# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.venv/

# Coverage artifacts. `pytest --cov` writes .coverage on every run, and AU-033
# made that run routine rather than occasional; parallel runs add .coverage.<host>
# .<pid>.<random>, so the glob is not optional. frontend/.gitignore already
# ignored its own coverage output, which is why only the Python side leaked.
.coverage
.coverage.*
coverage.xml
htmlcov/


# OS
.DS_Store

# Generated data (rebuild with the run365days CLI)
data/processed/*
!data/processed/.gitkeep
