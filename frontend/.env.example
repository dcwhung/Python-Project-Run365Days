# api    -> query the Flask GraphQL endpoint (default)
# static -> fetch the JSON files written by `run365-export --static-dir public/data`
VITE_DATA_MODE=api
# GraphQL endpoint for api mode (Vite proxies /api to Flask in development)
VITE_API_URL=/api/graphql
# Base path of the JSON files for static mode
VITE_STATIC_BASE=/data
